# Supabase の Project Settings > API から取得（未設定なら同じブラウザ内のタブ間だけで動くデモモード）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 計測（Umami Cloud の Website ID。docs/dev/02 §14）。未設定なら何も送らない。本番（Production）だけに入れ、Preview には入れない
VITE_UMAMI_WEBSITE_ID=
# 計測を送る本番のホスト名（未設定なら sukima-ee3.pages.dev）。これと完全一致しないホストでは送らない
VITE_UMAMI_HOST=
